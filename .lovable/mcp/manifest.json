        "description": "Cadastra um novo cliente no CRM da casa noturna.",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "nome": {
              "type": "string",
              "minLength": 1
            },
