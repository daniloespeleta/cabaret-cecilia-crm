              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "preferencias": {
              "description": "Preferências do cliente (bebidas, música, mesa etc).",
              "type": "string"
            },
            "tags": {
              "description": "Etiquetas: vip, regular, primeira_vez etc.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "observacoes": {
              "type": "string"
            }
          },
          "required": [
            "nome"
          ]
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        }
      },
